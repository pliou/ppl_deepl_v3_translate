page.includeCSS.pplDeeplSite = EXT:ppl_deepl_v3_translate/Resources/Public/Css/site.css
page.includeJSFooter.pplDeeplFrontendControls = EXT:ppl_deepl_v3_translate/Resources/Public/Javascript/frontend-controls.js
page.includeJSFooter.pplDeeplFrontendCopy = EXT:ppl_deepl_v3_translate/Resources/Public/Javascript/frontend-copy.js

plugin.tx_ppldeeplv3translate_deepl {
    settings {
        glossaryPid = {$plugin.tx_ppldeeplv3translate.settings.glossaryPid}
    }

    view {
        templateRootPaths.0 = EXT:ppl_deepl_v3_translate/Resources/Private/Templates/
        partialRootPaths.0 = EXT:ppl_deepl_v3_translate/Resources/Private/Partials/
        layoutRootPaths.0 = EXT:ppl_deepl_v3_translate/Resources/Private/Layouts/
    }

    features {
        skipDefaultArguments = 1
    }

    mvc {
        callDefaultActionIfActionCantBeResolved = 1
    }
}
plugin.tx_ppldeeplv3translate_deeplfile {
    settings < plugin.tx_ppldeeplv3translate.settings
}

plugin.tx_ppldeeplv3translate_deeplfile {
    view {
        templateRootPaths.0 = EXT:ppl_deepl_v3_translate/Resources/Private/Templates/
        partialRootPaths.0 = EXT:ppl_deepl_v3_translate/Resources/Private/Partials/
        layoutRootPaths.0 = EXT:ppl_deepl_v3_translate/Resources/Private/Layouts/
    }
}
